{
  "Name": "Codex Monitor",
  "Version": "0.1.0.0",
  "Author": "OpenAI Codex",
  "Description": "Shows the US runtime, MLB Elo v2, and the public-source Weather lane.",
  "Category": "Codex Monitor",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Icon": "imgs/plugin/marketplace",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "UUID": "com.codex.stream-monitor",
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "Actions": [
    {
      "Name": "US Runtime",
      "UUID": "com.codex.stream-monitor.noah.cycle",
      "Icon": "imgs/actions/slot",
      "Tooltip": "Shows the read-only US paper runtime and market-session state.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/slot",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "MLB Elo v2",
      "UUID": "com.codex.stream-monitor.noah.weekly-pnl",
      "Icon": "imgs/actions/slot",
      "Tooltip": "Shows the paper-only MLB Elo v2 runtime, captures, and settlements.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/slot",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Weather Public",
      "UUID": "com.codex.stream-monitor.noah.daily-pnl",
      "Icon": "imgs/actions/slot",
      "Tooltip": "Shows the public AWC and NWS Weather lane, including stale and blocked states.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/slot",
          "TitleAlignment": "middle"
        }
      ]
    }
  ]
}
