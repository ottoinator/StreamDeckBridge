{
  "name": "codex-stream-deck-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:plugin",
    "build:plugin": "rollup -c streamdeck-plugin/rollup.config.mjs",
    "bridge": "node bridge/monitor-bridge.mjs serve",
    "bridge:init": "node bridge/monitor-bridge.mjs init",
    "bridge:slots": "node bridge/monitor-bridge.mjs list",
    "bridge:threads": "node bridge/monitor-bridge.mjs threads",
    "bridge:state": "node bridge/monitor-bridge.mjs state",
    "plugin:install": "node scripts/run-platform-script.mjs plugin:install",
    "plugin:uninstall": "node scripts/run-platform-script.mjs plugin:uninstall",
    "service:install": "node scripts/run-platform-script.mjs service:install",
    "service:uninstall": "node scripts/run-platform-script.mjs service:uninstall",
    "service:start": "node scripts/run-platform-script.mjs service:start",
    "service:stop": "node scripts/run-platform-script.mjs service:stop",
    "doctor": "node scripts/run-platform-script.mjs doctor",
    "report:register": "node scripts/codex-bridge-thread.mjs register --watch",
    "report:progress": "node scripts/codex-bridge-thread.mjs progress"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.0.1"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.0",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^24.0.0",
    "rollup": "^4.32.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  }
}
